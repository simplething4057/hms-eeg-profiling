{"cells":[{"cell_type":"markdown","id":"c05be447","metadata":{"papermill":{"duration":0.002148,"end_time":"2026-10-23T10:26:41.791573+00:00","exception":false,"start_time":"2026-10-23T10:26:41.789425+00:00","status":"completed"},"tags":[]},"source":["# nb05_submit : Late Submission (인터넷 OFF) — 단일 실험 · 다중 모델 · P1 앙상블\n","\n","- **가속기 : GPU (T4)** · **인터넷 : OFF (필수, 대회 규칙 : ON으로 저장된 버전은 Submit 불가)**\n","- **입력** : 대회 데이터, Dataset `hms-src`, 모델 Output 1개\n","  - 단일 실험 (`PRESET=\"E4\"` 등) : 노트북 `Nb04_train` Output (해당 실험 버전)\n","  - 다중 모델·앙상블 (`PRESET=\"E4E5\"`, `\"E8\"`) : 노트북 `nb08_pack` Output (models/E4, E5, P1 + e8_recipe.json)\n","- **입력 방식 자동 인식** : 실험별 metrics.json의 settings.input → spec(10분) / eeg(50초) / both\n","- **출력** : `/kaggle/working/submission.csv`\n","\n","| 섹션 | 내용 |\n","|---|---|\n","| 0 | 설정 : PRESET → 레시피(모델 목록, 딥러닝 비중, P1 사용, T), 입력 탐색 |\n","| 1 | 테스트 전처리 : 학습과 같은 함수(eeg_segment, spec 변환), P1용 프로파일 지표 |\n","| 2 | 예측 : 실험별 fold 평균 → 실험 평균 → (P1) w·DL + (1−w)·P1 → T |\n","| 3 | 일관성 점검 : 학습 데이터 32건을 같은 경로로 다시 예측해 OOF와 비교 (딥러닝 실험별 + P1) |\n","| 4 | submission.csv 저장·검증 |"]},{"cell_type":"markdown","id":"388b2826","metadata":{"papermill":{"duration":0.001307,"end_time":"2026-10-23T10:26:41.794564+00:00","exception":false,"start_time":"2026-10-23T10:26:41.793257+00:00","status":"completed"},"tags":[]},"source":["## 0. 설정 (목적 : 제출 조합 지정·입력 탐색)"]},{"cell_type":"code","execution_count":1,"id":"f429095e","metadata":{"execution":{"iopub.execute_input":"2026-10-23T10:26:41.798774Z","iopub.status.busy":"2026-10-23T10:26:41.798426Z","iopub.status.idle":"2026-10-23T10:27:42.700249Z","shell.execute_reply":"2026-10-23T10:27:42.69905Z"},"papermill":{"duration":60.907433,"end_time":"2026-10-23T10:27:42.703342+00:00","exception":false,"start_time":"2026-10-23T10:26:41.795909+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["PRESET=E8 | 레시피 {'candidate': 'E4+E5 + P1v2', 'models': ['E4', 'E5'], 'dl_weight': 0.85, 'use_p1': True, 'temperature': 1.0, 'cv_kl_high_nested': 0.2955, 'dl_versions': {'E4': 6, 'E5': 7}}\n","DEVICE=cuda | DATA_DIR=/kaggle/input/competitions/hms-harmful-brain-activity-classification\n","SRC_ROOT=/kaggle/input/datasets/sungik4057/hms-src\n","  E4 : /kaggle/input/notebooks/sungik4057/nb08-pack/models/E4 | fold 가중치 5개 | 입력 both\n","  E5 : /kaggle/input/notebooks/sungik4057/nb08-pack/models/E5 | fold 가중치 5개 | 입력 both\n","  P1 : /kaggle/input/notebooks/sungik4057/nb08-pack/models/P1 | fold 모델 5개 | 입력 67열\n"]}],"source":["PRESET = \"E8\"          # \"E2\"·\"E3\"·\"E4\"·\"E5\" : 단일 실험 / \"E4E5\" : E4·E5 평균 (+T) / \"E8\" : e8_recipe.json (E4·E5 + P1v2)\n","\n","PRESETS = {\n","    \"E4E5\": {\"models\": [\"E4\", \"E5\"], \"dl_weight\": 1.0, \"use_p1\": False, \"temperature\": 1.09},   # nb07 v2 : E4+E5+T, T fold별 1.08~1.10\n","}\n","for e in [\"E1\", \"E2\", \"E3\", \"E4\", \"E5\"]:\n","    PRESETS[e] = {\"models\": [e], \"dl_weight\": 1.0, \"use_p1\": False, \"temperature\": 1.0}\n","\n","import sys, os, time, json\n","from pathlib import Path\n","\n","def find_first(pattern_tail, root=\"/kaggle/input\", depth=6):\n","    for d in range(1, depth + 1):\n","        hits = sorted(Path(root).glob(\"/\".join([\"*\"] * d) + \"/\" + pattern_tail))\n","        if hits:\n","            return hits[0]\n","    return None\n","\n","src_hit = find_first(\"src/data/targets.py\")\n","assert src_hit, \"hms-src를 찾지 못했습니다. Add Input에서 hms-src를 연결하세요.\"\n","SRC_ROOT = src_hit.parents[2]\n","sys.path.insert(0, str(SRC_ROOT))\n","\n","if PRESET == \"E8\":\n","    recipe_hit = find_first(\"e8_recipe.json\")\n","    assert recipe_hit, \"e8_recipe.json을 찾지 못했습니다. Add Input에서 nb08_pack Output을 연결하세요.\"\n","    RECIPE = json.load(open(recipe_hit))\n","else:\n","    RECIPE = dict(PRESETS[PRESET])\n","\n","import numpy as np\n","import pandas as pd\n","import torch\n","import torch.nn.functional as F\n","import timm\n","from src.data.load import find_data_dir, spec_window\n","from src.data.build import eeg_segment\n","from src.data.targets import build_targets, select_representative, PROB_COLS, CLASSES\n","from src.models.eeg_spec import HMSNet\n","\n","DATA_DIR = find_data_dir()\n","DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","\n","EXP_DIRS, EXP_INPUT = {}, {}\n","for exp in RECIPE[\"models\"]:\n","    hit = find_first(f\"models/{exp}/fold0.pt\")\n","    assert hit, f\"models/{exp}/fold0.pt를 찾지 못했습니다. 모델 Output(Nb04_train 또는 nb08_pack) 연결을 확인하세요.\"\n","    EXP_DIRS[exp] = hit.parent\n","    with open(hit.parent / \"metrics.json\") as f:\n","        EXP_INPUT[exp] = json.load(f)[\"settings\"].get(\"input\", \"spec\")     # E1·E2 metrics.json에는 input 항목 없음 → spec\n","P1_DIR = None\n","if RECIPE[\"use_p1\"]:\n","    hit = find_first(\"models/P1/p1_meta.json\")\n","    assert hit, \"models/P1/p1_meta.json을 찾지 못했습니다. nb08_pack Output을 연결하세요.\"\n","    P1_DIR = hit.parent\n","    P1_META = json.load(open(hit))\n","\n","NEED_SPEC = RECIPE[\"use_p1\"] or any(v in (\"spec\", \"both\") for v in EXP_INPUT.values())\n","NEED_EEG = RECIPE[\"use_p1\"] or any(v in (\"eeg\", \"both\") for v in EXP_INPUT.values())\n","try:                                                       # 인터넷 ON 저장 버전은 제출 불가 → 미리 경고\n","    import socket; socket.create_connection((\"www.kaggle.com\", 443), timeout=3).close()\n","    print(\"[경고] 인터넷이 켜져 있습니다. Settings → Internet Off 후 Save Version 해야 Submit 가능합니다.\")\n","except OSError:\n","    pass\n","print(f\"PRESET={PRESET} | 레시피 {RECIPE}\")\n","print(f\"DEVICE={DEVICE} | DATA_DIR={DATA_DIR}\\nSRC_ROOT={SRC_ROOT}\")\n","for exp, d in EXP_DIRS.items():\n","    print(f\"  {exp} : {d} | fold 가중치 {len(list(d.glob('fold[0-9].pt')))}개 | 입력 {EXP_INPUT[exp]}\")\n","if P1_DIR is not None:\n","    print(f\"  P1 : {P1_DIR} | fold 모델 {len(list(P1_DIR.glob('fold[0-9].txt')))}개 | 입력 {len(P1_META['x_cols'])}열\")"]},{"cell_type":"markdown","id":"6c392153","metadata":{"papermill":{"duration":0.001596,"end_time":"2026-10-23T10:27:42.706552+00:00","exception":false,"start_time":"2026-10-23T10:27:42.704956+00:00","status":"completed"},"tags":[]},"source":["## 1. 전처리 (목적 : 학습(nb02·nb03·nb04)과 동일한 입력 생성)"]},{"cell_type":"code","execution_count":2,"id":"4cf5dbcf","metadata":{"execution":{"iopub.execute_input":"2026-10-23T10:27:42.711688Z","iopub.status.busy":"2026-10-23T10:27:42.711041Z","iopub.status.idle":"2026-10-23T10:27:48.657873Z","shell.execute_reply":"2026-10-23T10:27:48.656754Z"},"papermill":{"duration":5.951986,"end_time":"2026-10-23T10:27:48.660034+00:00","exception":false,"start_time":"2026-10-23T10:27:42.708048+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["테스트 1건 | spec 입력 (1, 1, 400, 300) | 평균 0.000\n","테스트 1건 | eeg 입력 (1, 16, 10000) | 평균 -0.001\n","테스트 1건 | P1 입력 (1, 67) | 평균 4.589\n","전처리 0.3s\n"]}],"source":["def spec10(spec_df, offset):\n","    \"\"\"10분 스펙트로그램 → nb02 저장 형식과 같은 (4, 100, 300) float16 log1p 배열 (P1 지표 입력).\"\"\"\n","    return np.log1p(np.clip(spec_window(spec_df, offset), 0, None)).astype(np.float16)\n","\n","def spec_image(s10):\n","    \"\"\"nb04 입력 : float32 변환 후 4부위 세로 연결 (1, 400, 300), 표본별 표준화.\"\"\"\n","    x = s10.astype(np.float32).reshape(-1, 300)\n","    return ((x - x.mean()) / (x.std() + 1e-6))[None]\n","\n","def build_inputs(df, split, spec_offsets=None, eeg_offsets=None):\n","    \"\"\"행마다 (스펙트로그램 이미지, 50초 몽타주, P1 입력 행). 테스트 파일은 이미 10분·50초 구간 (offset 0).\"\"\"\n","    XS, XE, XP = [], [], []\n","    for i, r in enumerate(df.itertuples()):\n","        s = e = qc = None\n","        if NEED_SPEC:\n","            spec = pd.read_parquet(DATA_DIR / f\"{split}_spectrograms\" / f\"{r.spectrogram_id}.parquet\")\n","            s = spec10(spec, float(spec[\"time\"].min()) if spec_offsets is None else spec_offsets[i])\n","            XS.append(spec_image(s))\n","        if NEED_EEG:\n","            eeg = pd.read_parquet(DATA_DIR / f\"{split}_eegs\" / f\"{r.eeg_id}.parquet\")\n","            e, qc = eeg_segment(eeg, 0.0 if eeg_offsets is None else eeg_offsets[i])   # float16 (16, 10000) : nb02와 같음\n","            XE.append(e.astype(np.float32))\n","        if P1_DIR is not None:\n","            f = profile_features(e, s)                                                  # nb03과 같은 float16 입력\n","            f.update({k: qc[k] for k in P1_META[\"qc\"]})\n","            XP.append([f[c] for c in P1_META[\"x_cols\"]])\n","    stack = lambda a: np.stack(a).astype(np.float32) if a else None\n","    return stack(XS), stack(XE), (np.array(XP, dtype=np.float64) if XP else None)\n","\n","if P1_DIR is not None:\n","    from src.profile.qeeg import profile_features\n","    import lightgbm as lgb\n","\n","t0 = time.time()\n","test = pd.read_csv(DATA_DIR / \"test.csv\")\n","sub_template = pd.read_csv(DATA_DIR / \"sample_submission.csv\")\n","XS_test, XE_test, XP_test = build_inputs(test, \"test\")\n","for name, a in [(\"spec\", XS_test), (\"eeg\", XE_test), (\"P1\", XP_test)]:\n","    if a is not None:\n","        print(f\"테스트 {len(test)}건 | {name} 입력 {a.shape} | 평균 {a.mean():.3f}\")\n","print(f\"전처리 {time.time() - t0:.1f}s\")"]},{"cell_type":"markdown","id":"8f680e13","metadata":{"papermill":{"duration":0.002562,"end_time":"2026-10-23T10:27:48.665119+00:00","exception":false,"start_time":"2026-10-23T10:27:48.662557+00:00","status":"completed"},"tags":[]},"source":["## 2. 예측 (목적 : 실험별 fold 평균 → 실험 평균 → P1 결합 → 온도 보정)"]},{"cell_type":"code","execution_count":3,"id":"a0b0dff8","metadata":{"execution":{"iopub.execute_input":"2026-10-23T10:27:48.67092Z","iopub.status.busy":"2026-10-23T10:27:48.670602Z","iopub.status.idle":"2026-10-23T10:28:14.652861Z","shell.execute_reply":"2026-10-23T10:28:14.651484Z"},"papermill":{"duration":25.987984,"end_time":"2026-10-23T10:28:14.654874+00:00","exception":false,"start_time":"2026-10-23T10:27:48.66689+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["예측 완료 26.0s | 실험 ['E4', 'E5'] (fold [5, 5]) + P1 fold 5개, 딥러닝 비중 0.85 | T 1.0 | 예측 합 [1.]\n"]}],"source":["def load_model(path, input_mode):\n","    bb = timm.create_model(\"efficientnet_b0\", pretrained=False, in_chans=1, num_classes=len(CLASSES))  # 인터넷 불필요\n","    bb.load_state_dict(torch.load(path, map_location=\"cpu\"))       # 저장 가중치는 백본만 (E1~E5 공통 형식)\n","    return HMSNet(bb, input_mode).to(DEVICE).eval()\n","\n","@torch.no_grad()\n","def predict(model, XS, XE, bs=64):\n","    n, out = len(XS if XS is not None else XE), []\n","    for i in range(0, n, bs):\n","        s = torch.from_numpy(XS[i:i + bs]).to(DEVICE) if model.input_mode != \"eeg\" else None\n","        e = torch.from_numpy(XE[i:i + bs]).to(DEVICE) if model.input_mode != \"spec\" else None\n","        with torch.autocast(device_type=\"cuda\", enabled=DEVICE == \"cuda\"):\n","            out.append(F.softmax(model(s, e).float(), dim=1).cpu().numpy())\n","    return np.concatenate(out)\n","\n","def temp(p, T):\n","    if T == 1.0:\n","        return p\n","    z = np.log(np.clip(p, 1e-7, 1)) / T\n","    z = np.exp(z - z.max(axis=1, keepdims=True))\n","    return z / z.sum(axis=1, keepdims=True)\n","\n","t0 = time.time()\n","MODELS = {exp: {int(p.stem[4:]): load_model(p, EXP_INPUT[exp]) for p in sorted(d.glob(\"fold[0-9].pt\"))}\n","          for exp, d in EXP_DIRS.items()}                            # fold0~4.pt만 (stage1 가중치 제외)\n","pred_exp = {exp: np.mean([predict(m, XS_test, XE_test) for m in ms.values()], axis=0) for exp, ms in MODELS.items()}\n","pred_dl = np.mean(list(pred_exp.values()), axis=0)                   # 실험 같은 비중 평균\n","pred = pred_dl\n","if P1_DIR is not None:\n","    P1_MODELS = {int(p.stem[4:]): lgb.Booster(model_file=str(p)) for p in sorted(P1_DIR.glob(\"fold[0-9].txt\"))}\n","    pred_p1 = np.mean([b.predict(XP_test) for b in P1_MODELS.values()], axis=0)\n","    w = RECIPE[\"dl_weight\"]\n","    pred = w * pred_dl + (1 - w) * pred_p1\n","pred_test = temp(pred, RECIPE[\"temperature\"])\n","print(f\"예측 완료 {time.time() - t0:.1f}s | 실험 {list(MODELS)} (fold {[len(v) for v in MODELS.values()]})\"\n","      + (f\" + P1 fold {len(P1_MODELS)}개, 딥러닝 비중 {RECIPE['dl_weight']}\" if P1_DIR is not None else \"\")\n","      + f\" | T {RECIPE['temperature']} | 예측 합 {pred_test.sum(axis=1).round(4)[:3]}\")"]},{"cell_type":"markdown","id":"c733997a","metadata":{"papermill":{"duration":0.001655,"end_time":"2026-10-23T10:28:14.658392+00:00","exception":false,"start_time":"2026-10-23T10:28:14.656737+00:00","status":"completed"},"tags":[]},"source":["## 3. 일관성 점검 (목적 : 학습·추론 전처리 불일치 탐지, 공개 테스트 1건일 때만 실행)"]},{"cell_type":"code","execution_count":4,"id":"d5ea8e78","metadata":{"execution":{"iopub.execute_input":"2026-10-23T10:28:14.664129Z","iopub.status.busy":"2026-10-23T10:28:14.663551Z","iopub.status.idle":"2026-10-23T10:28:36.97666Z","shell.execute_reply":"2026-10-23T10:28:36.975543Z"},"papermill":{"duration":22.317947,"end_time":"2026-10-23T10:28:36.978466+00:00","exception":false,"start_time":"2026-10-23T10:28:14.660519+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["OOF 재현 점검 E4 : 32건 | 최대 차이 0.0013\n","OOF 재현 점검 E5 : 32건 | 최대 차이 0.0010\n","OOF 재현 점검 P1 : 32건 | 최대 차이 0.0000\n"]}],"source":["# 학습 데이터 32건을 같은 추론 경로로 다시 예측해 학습 때 저장한 OOF와 비교 (각 행은 자신이 검증 fold였던 모델로 예측).\n","# 딥러닝 실험별 + P1(테스트용 지표 산출 경로까지 점검). 차이가 크면 전처리 불일치 → 제출 중단. 숨김 테스트 재실행 때는 건너뜀.\n","if len(test) < 10:\n","    rep = select_representative(build_targets(pd.read_csv(DATA_DIR / \"train.csv\")))\n","    cols = [\"eeg_id\", \"spectrogram_id\", \"spectrogram_label_offset_seconds\", \"eeg_label_offset_seconds\"]\n","    first = pd.read_csv(EXP_DIRS[RECIPE[\"models\"][0]] / \"oof.csv\")\n","    chk = first.sample(min(32, len(first)), random_state=0)[[\"eeg_id\", \"fold\"]].merge(rep[cols], on=\"eeg_id\")\n","    XS, XE, XP = build_inputs(chk, \"train\", chk.spectrogram_label_offset_seconds.to_numpy(), chk.eeg_label_offset_seconds.to_numpy())\n","    PRED = [f\"pred_{c}\" for c in CLASSES]\n","    checks = {}\n","    for exp, ms in MODELS.items():\n","        ref = pd.read_csv(EXP_DIRS[exp] / \"oof.csv\").set_index(\"eeg_id\").loc[chk.eeg_id, PRED].to_numpy()\n","        p = np.zeros_like(ref)\n","        for k in chk.fold.unique():\n","            idx = (chk.fold == k).to_numpy()\n","            p[idx] = predict(ms[int(k)], XS[idx] if XS is not None else None, XE[idx] if XE is not None else None)\n","        checks[exp] = np.abs(p - ref).max()\n","    if P1_DIR is not None:\n","        ref = pd.read_csv(P1_DIR / \"oof.csv\").set_index(\"eeg_id\").loc[chk.eeg_id, PRED].to_numpy()\n","        p = np.zeros_like(ref)\n","        for k in chk.fold.unique():\n","            idx = (chk.fold == k).to_numpy()\n","            p[idx] = P1_MODELS[int(k)].predict(XP[idx])\n","        checks[\"P1\"] = np.abs(p - ref).max()\n","    for name, d in checks.items():\n","        print(f\"OOF 재현 점검 {name} : {len(chk)}건 | 최대 차이 {d:.4f}\")\n","    assert max(checks.values()) < 0.02, \"학습 때 예측과 다릅니다 : 전처리 불일치 가능성 → 제출 중단\"\n","else:\n","    print(\"일관성 점검 건너뜀 (숨김 테스트 실행)\")"]},{"cell_type":"markdown","id":"96c6c323","metadata":{"papermill":{"duration":0.00167,"end_time":"2026-10-23T10:28:36.982+00:00","exception":false,"start_time":"2026-10-23T10:28:36.98033+00:00","status":"completed"},"tags":[]},"source":["## 4. 제출 파일 (목적 : 양식 검증 후 저장)"]},{"cell_type":"code","execution_count":5,"id":"2b1bc1dc","metadata":{"execution":{"iopub.execute_input":"2026-10-23T10:28:36.987174Z","iopub.status.busy":"2026-10-23T10:28:36.986423Z","iopub.status.idle":"2026-10-23T10:28:37.023501Z","shell.execute_reply":"2026-10-23T10:28:37.022731Z"},"papermill":{"duration":0.042061,"end_time":"2026-10-23T10:28:37.025676+00:00","exception":false,"start_time":"2026-10-23T10:28:36.983615+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        v