","\n","import sys, os, time\n","from pathlib import Path\n","\n","def find_first(pattern_tail, root=\"/kaggle/input\", depth=6):\n","    for d in range(1, depth + 1):\n","        hits = sorted(Path(root).glob(\"/\".join([\"*\"] * d) + \"/\" + pattern_tail))\n","        if hits:\n","            return hits[0]\n","    return None\n","\n","src_hit = find_first(\"src/data/targets.py\")\n","assert src_hit, \"hms-src를 찾지 못했습니다. Add Input에서 hms-src를 연결하세요.\"\n","SRC_ROOT = src_hit.parents[2]\n","sys.path.insert(0, str(SRC_ROOT))\n","\n","model_hit = find_first(f\"models/{EXP}/fold0.pt\")\n","assert model_hit, f\"models/{EXP}/fold0.pt를 찾지 못했습니다. Add Input에서 Nb04train 노트북 Output을 연결하세요.\"\n","MODEL_DIR = model_hit.parent\n","\n","import numpy as np\n","import pandas as pd\n","import torch\n","import torch.nn.functional as F\n","import timm\n","from src.data.load import find_data_dir, spec_window\n","from src.data.targets import build_targets, select_representative, PROB_COLS, CLASSES\n","\n","DATA_DIR = find_data_dir()\n","DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","FOLD_FILES = sorted(MODEL_DIR.glob(\"fold[0-9].pt\"))   # fold0~4.pt만 (E2의 *_stage1.pt 제외)\n","print(f\"DEVICE={DEVICE} | DATA_DIR={DATA_DIR}\\nSRC_ROOT={SRC_ROOT}\\nMODEL_DIR={MODEL_DIR} | fold 가중치 {len(FOLD_FILES)}개\")"]},{"cell_type":"markdown","id":"ae7d6497","metadata":{"papermill":{"duration":0.001286,"end_time":"2026-10-23T00:04:41.675391+00:00","exception":false,"start_time":"2026-10-23T00:04:41.674105+00:00","status":"completed"},"tags":[]},"source":["## 1. 전처리 (목적 : 학습(nb02·nb04)과 동일한 입력 생성)"]},{"cell_type":"code","execution_count":2,"id":"40bb7f1e","metadata":{"execution":{"iopub.execute_input":"2026-10-23T00:04:41.67925Z","iopub.status.busy":"2026-10-23T00:04:41.678841Z","iopub.status.idle":"2026-10-23T00:04:42.119523Z","shell.execute_reply":"2026-10-23T00:04:42.118402Z"},"papermill":{"duration":0.444909,"end_time":"2026-10-23T00:04:42.121531+00:00","exception":false,"start_time":"2026-10-23T00:04:41.676622+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["테스트 1건 | 입력 (1, 1, 400, 300) | 평균 0.000 표준편차 1.000\n"]}],"source":["def spec_image(spec_df, offset):\n","    \"\"\"10분 스펙트로그램 → 학습과 같은 (1, 400, 300) 입력.\n","    nb02 : log1p(clip ≥ 0) 후 float16 저장 / nb04 : float32 변환, 표본별 표준화\"\"\"\n","    s = spec_window(spec_df, offset)                                   # (4, 100, 300)\n","    s = np.log1p(np.clip(s, 0, None)).astype(np.float16).astype(np.float32)\n","    x = s.reshape(-1, 300)\n","    return ((x - x.mean()) / (x.std() + 1e-6))[None]\n","\n","test = pd.read_csv(DATA_DIR / \"test.csv\")\n","sub_template = pd.read_csv(DATA_DIR / \"sample_submission.csv\")\n","X_test = []\n","for sid in test.spectrogram_id:\n","    spec = pd.read_parquet(DATA_DIR / \"test_spectrograms\" / f\"{sid}.parquet\")\n","    X_test.append(spec_image(spec, float(spec[\"time\"].min())))      # 테스트 파일은 이미 10분 구간\n","X_test = np.stack(X_test).astype(np.float32)\n","print(f\"테스트 {len(test)}건 | 입력 {X_test.shape} | 평균 {X_test.mean():.3f} 표준편차 {X_test.std():.3f}\")"]},{"cell_type":"markdown","id":"c3dbf1b5","metadata":{"papermill":{"duration":0.001839,"end_time":"2026-10-23T00:04:42.125431+00:00","exception":false,"start_time":"2026-10-23T00:04:42.123592+00:00","status":"completed"},"tags":[]},"source":["## 2. 예측 (목적 : fold 가중치별 예측 후 평균)"]},{"cell_type":"code","execution_count":3,"id":"0156aee1","metadata":{"execution":{"iopub.execute_input":"2026-10-23T00:04:42.130414Z","iopub.status.busy":"2026-10-23T00:04:42.130107Z","iopub.status.idle":"2026-10-23T00:04:53.394206Z","shell.execute_reply":"2026-10-23T00:04:53.393307Z"},"papermill":{"duration":11.268516,"end_time":"2026-10-23T00:04:53.395828+00:00","exception":false,"start_time":"2026-10-23T00:04:42.127312+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["fold [0, 1, 2, 3, 4] 평균 예측 완료 11.3s | 예측 합 [1.]\n"]}],"source":["def load_model(path):\n","    m = timm.create_model(\"efficientnet_b0\", pretrained=False, in_chans=1, num_classes=len(CLASSES))  # 인터넷 불필요\n","    m.load_state_dict(torch.load(path, map_location=\"cpu\"))\n","    return m.to(DEVICE).eval()\n","\n","@torch.no_grad()\n","def predict(model, X, bs=64):\n","    out = []\n","    for i in range(0, len(X), bs):\n","        xb = torch.from_numpy(X[i:i + bs]).to(DEVICE)\n","        with torch.autocast(device_type=\"cuda\", enabled=DEVICE == \"cuda\"):\n","            out.append(F.softmax(model(xb).float(), dim=1).cpu().numpy())\n","    return np.concatenate(out)\n","\n","t0 = time.time()\n","models = {int(p.stem.replace(\"fold\", \"\")): load_model(p) for p in FOLD_FILES}\n","pred_test = np.mean([predict(m, X_test) for m in models.values()], axis=0)\n","print(f\"fold {sorted(models)} 평균 예측 완료 {time.time() - t0:.1f}s | 예측 합 {pred_test.sum(axis=1).round(4)[:5]}\")"]},{"cell_type":"markdown","id":"1a397e0d","metadata":{"papermill":{"duration":0.001431,"end_time":"2026-10-23T00:04:53.39885+00:00","exception":false,"start_time":"2026-10-23T00:04:53.397419+00:00","status":"completed"},"tags":[]},"source":["## 3. 일관성 점검 (목적 : 학습·추론 전처리 불일치 탐지, 공개 테스트 1건일 때만 실행)"]},{"cell_type":"code","execution_count":4,"id":"380876d4","metadata":{"execution":{"iopub.execute_input":"2026-10-23T00:04:53.40326Z","iopub.status.busy":"2026-10-23T00:04:53.402688Z","iopub.status.idle":"2026-10-23T00:05:10.793168Z","shell.execute_reply":"2026-10-23T00:05:10.792199Z"},"papermill":{"duration":17.394563,"end_time":"2026-10-23T00:05:10.795+00:00","exception":false,"start_time":"2026-10-23T00:04:53.400437+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["OOF 재현 점검 32건 | 최대 차이 0.0011 | 평균 0.0003\n"]}],"source":["# 같은 추론 경로로 학습 데이터 일부를 다시 예측해, 학습 때 저장한 OOF 예측과 같은지 확인한다.\n","# 차이가 크면 전처리(구간 선택, 변환, 표준화)가 학습 때와 다르다는 뜻이다. 숨김 테스트 재실행 때는 건너뜀.\n","if len(test) < 10 and (MODEL_DIR / \"oof.csv\").exists():\n","    oof = pd.read_csv(MODEL_DIR / \"oof.csv\")\n","    rep = select_representative(build_targets(pd.read_csv(DATA_DIR / \"train.csv\")))\n","    chk = oof.sample(min(32, len(oof)), random_state=0).merge(\n","        rep[[\"eeg_id\", \"spectrogram_id\", \"spectrogram_label_offset_seconds\"]], on=\"eeg_id\")\n","    diffs = []\n","    for k, g in chk.groupby(\"fold\"):\n","        if k not in models:\n","            continue\n","        Xc = np.stack([spec_image(pd.read_parquet(DATA_DIR / \"train_spectrograms\" / f\"{r.spectrogram_id}.parquet\"),\n","                                  r.spectrogram_label_offset_seconds) for r in g.itertuples()]).astype(np.float32)\n","        p = predict(models[k], Xc)\n","        diffs.append(np.abs(p - g[[f\"pred_{c}\" for c in CLASSES]].to_numpy()).max(axis=1))\n","    diffs = np.concatenate(diffs)\n","    print(f\"OOF 재현 점검 {len(diffs)}건 | 최대 차이 {diffs.max():.4f} | 평균 {diffs.mean():.4f}\")\n","    assert diffs.max() < 0.02, \"학습 때 예측과 다릅니다 : 전처리 불일치 가능성 → 제출 중단\"\n","else:\n","    print(\"일관성 점검 건너뜀 (숨김 테스트 실행 또는 oof.csv 없음)\")"]},{"cell_type":"markdown","id":"f0f59c64","metadata":{"papermill":{"duration":0.001556,"end_time":"2026-10-23T00:05:10.798231+00:00","exception":false,"start_time":"2026-10-23T00:05:10.796675+00:00","status":"completed"},"tags":[]},"source":["## 4. 제출 파일 (목적 : 양식 검증 후 저장)"]},{"cell_type":"code","execution_count":5,"id":"f84ece0c","metadata":{"execution":{"iopub.execute_input":"2026-10-23T00:05:10.80307Z","iopub.status.busy":"2026-10-23T00:05:10.802747Z","iopub.status.idle":"2026-10-23T00:05:10.841494Z","shell.execute_reply":"2026-10-23T00:05:10.840592Z"},"papermill":{"duration":0.043225,"end_time":"2026-10-23T00:05:10.842896+00:00","exception":false,"start_time":"2026-10-23T00:05:10.799671+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","   