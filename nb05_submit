{"cells":[{"cell_type":"markdown","id":"e1284738","metadata":{"papermill":{"duration":0.001931,"end_time":"2026-10-23T06:25:45.118595+00:00","exception":false,"start_time":"2026-10-23T06:25:45.116664+00:00","status":"completed"},"tags":[]},"source":["# nb05_submit : Late Submission (인터넷 OFF)\n","\n","- **가속기 : GPU (T4)** · **인터넷 : OFF (필수, 대회 규칙)**\n","- **입력** : 대회 데이터, Dataset `hms-src`, 노트북 `Nb04train` Output (models/<EXP>/fold*.pt, metrics.json)\n","- **입력 방식 자동 인식** : metrics.json의 settings.input → spec(E1·E2, 10분 스펙트로그램) / eeg(E3, 50초 EEG) / both(E4)\n","- **출력** : `/kaggle/working/submission.csv`\n","\n","| 섹션 | 내용 |\n","|---|---|\n","| 0 | 설정, 입력 탐색 (대회 데이터·src·가중치) |\n","| 1 | 테스트 스펙트로그램 → 학습과 같은 전처리 |\n","| 2 | fold별 예측 → 평균 |\n","| 3 | 일관성 점검 : 같은 경로로 학습 데이터를 다시 예측해 OOF와 비교 (공개 테스트 1건일 때만) |\n","| 4 | submission.csv 저장·검증 |\n","\n","**제출 방법** : Save Version → Save & Run All 완료 후, 버전 화면 Output의 submission.csv 옆 **Submit** (또는 대회 페이지 → Submit Prediction → 이 노트북 선택)"]},{"cell_type":"markdown","id":"9d476508","metadata":{"papermill":{"duration":0.001258,"end_time":"2026-10-23T06:25:45.121325+00:00","exception":false,"start_time":"2026-10-23T06:25:45.120067+00:00","status":"completed"},"tags":[]},"source":["## 0. 설정 (목적 : 입력 탐색 / 출력 : DATA_DIR, MODEL_DIR)"]},{"cell_type":"code","execution_count":1,"id":"1fd8075d","metadata":{"execution":{"iopub.execute_input":"2026-10-23T06:25:45.125794Z","iopub.status.busy":"2026-10-23T06:25:45.125071Z","iopub.status.idle":"2026-10-23T06:26:10.645872Z","shell.execute_reply":"2026-10-23T06:26:10.644633Z"},"papermill":{"duration":25.524885,"end_time":"2026-10-23T06:26:10.64756+00:00","exception":false,"start_time":"2026-10-23T06:25:45.122675+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["DEVICE=cuda | DATA_DIR=/kaggle/input/competitions/hms-harmful-brain-activity-classification\n","SRC_ROOT=/kaggle/input/datasets/sungik4057/hms-src\n","MODEL_DIR=/kaggle/input/notebooks/sungik4057/nb04-train/models/E4 | fold 가중치 5개 | 입력 both\n"]}],"source":["EXP = \"E4\"            # 제출할 실험 (Nb04train Output의 models/<EXP>)\n","\n","import sys, os, time, json\n","from pathlib import Path\n","\n","def find_first(pattern_tail, root=\"/kaggle/input\", depth=6):\n","    for d in range(1, depth + 1):\n","        hits = sorted(Path(root).glob(\"/\".join([\"*\"] * d) + \"/\" + pattern_tail))\n","        if hits:\n","            return hits[0]\n","    return None\n","\n","src_hit = find_first(\"src/data/targets.py\")\n","assert src_hit, \"hms-src를 찾지 못했습니다. Add Input에서 hms-src를 연결하세요.\"\n","SRC_ROOT = src_hit.parents[2]\n","sys.path.insert(0, str(SRC_ROOT))\n","\n","model_hit = find_first(f\"models/{EXP}/fold0.pt\")\n","assert model_hit, f\"models/{EXP}/fold0.pt를 찾지 못했습니다. Add Input에서 Nb04train 노트북 Output을 연결하세요.\"\n","MODEL_DIR = model_hit.parent\n","\n","import numpy as np\n","import pandas as pd\n","import torch\n","import torch.nn.functional as F\n","import timm\n","from src.data.load import find_data_dir, spec_window\n","from src.data.build import eeg_segment\n","from src.models.eeg_spec import HMSNet\n","from src.data.targets import build_targets, select_representative, PROB_COLS, CLASSES\n","\n","DATA_DIR = find_data_dir()\n","DEVICE = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","FOLD_FILES = sorted(MODEL_DIR.glob(\"fold[0-9].pt\"))   # fold0~4.pt만 (E2의 *_stage1.pt 제외)\n","with open(MODEL_DIR / \"metrics.json\") as f:\n","    INPUT = json.load(f)[\"settings\"].get(\"input\", \"spec\")   # E1·E2 metrics.json에는 input 항목이 없음 → spec\n","USE_SPEC, USE_EEG = INPUT in (\"spec\", \"both\"), INPUT in (\"eeg\", \"both\")\n","print(f\"DEVICE={DEVICE} | DATA_DIR={DATA_DIR}\\nSRC_ROOT={SRC_ROOT}\\nMODEL_DIR={MODEL_DIR} | fold 가중치 {len(FOLD_FILES)}개 | 입력 {INPUT}\")"]},{"cell_type":"markdown","id":"945089aa","metadata":{"papermill":{"duration":0.001689,"end_time":"2026-10-23T06:26:10.650847+00:00","exception":false,"start_time":"2026-10-23T06:26:10.649158+00:00","status":"completed"},"tags":[]},"source":["## 1. 전처리 (목적 : 학습(nb02·nb04)과 동일한 입력 생성)"]},{"cell_type":"code","execution_count":2,"id":"d5e09642","metadata":{"execution":{"iopub.execute_input":"2026-10-23T06:26:10.655529Z","iopub.status.busy":"2026-10-23T06:26:10.654912Z","iopub.status.idle":"2026-10-23T06:26:11.020477Z","shell.execute_reply":"2026-10-23T06:26:11.019655Z"},"papermill":{"duration":0.369488,"end_time":"2026-10-23T06:26:11.022113+00:00","exception":false,"start_time":"2026-10-23T06:26:10.652625+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["테스트 1건 | spec 입력 (1, 1, 400, 300) | 평균 0.000 표준편차 1.000\n","테스트 1건 | eeg 입력 (1, 16, 10000) | 평균 -0.001 표준편차 10.708\n"]}],"source":["def spec_image(spec_df, offset):\n","    \"\"\"10분 스펙트로그램 → 학습과 같은 (1, 400, 300) 입력.\n","    nb02 : log1p(clip ≥ 0) 후 float16 저장 / nb04 : float32 변환, 표본별 표준화\"\"\"\n","    s = spec_window(spec_df, offset)                                   # (4, 100, 300)\n","    s = np.log1p(np.clip(s, 0, None)).astype(np.float16).astype(np.float32)\n","    x = s.reshape(-1, 300)\n","    return ((x - x.mean()) / (x.std() + 1e-6))[None]\n","\n","def eeg_input(eeg_df, offset):\n","    \"\"\"50초 EEG → 학습과 같은 (16, 10000) 몽타주. nb02와 같은 eeg_segment 사용 (보간·0.5~20Hz 필터·±3000 제한·float16).\"\"\"\n","    return eeg_segment(eeg_df, offset)[0].astype(np.float32)\n","\n","def build_inputs(df, split, spec_offsets=None, eeg_offsets=None):\n","    Xs, Xe = [], []\n","    for i, r in enumerate(df.itertuples()):\n","        if USE_SPEC:\n","            spec = pd.read_parquet(DATA_DIR / f\"{split}_spectrograms\" / f\"{r.spectrogram_id}.parquet\")\n","            Xs.append(spec_image(spec, float(spec[\"time\"].min()) if spec_offsets is None else spec_offsets[i]))\n","        if USE_EEG:\n","            eeg = pd.read_parquet(DATA_DIR / f\"{split}_eegs\" / f\"{r.eeg_id}.parquet\")\n","            Xe.append(eeg_input(eeg, 0.0 if eeg_offsets is None else eeg_offsets[i]))\n","    return (np.stack(Xs).astype(np.float32) if Xs else None, np.stack(Xe).astype(np.float32) if Xe else None)\n","\n","test = pd.read_csv(DATA_DIR / \"test.csv\")\n","sub_template = pd.read_csv(DATA_DIR / \"sample_submission.csv\")\n","XS_test, XE_test = build_inputs(test, \"test\")                      # 테스트 파일은 이미 10분·50초 구간 (offset 0)\n","for name, a in [(\"spec\", XS_test), (\"eeg\", XE_test)]:\n","    if a is not None:\n","        print(f\"테스트 {len(test)}건 | {name} 입력 {a.shape} | 평균 {a.mean():.3f} 표준편차 {a.std():.3f}\")"]},{"cell_type":"markdown","id":"dd117fe8","metadata":{"papermill":{"duration":0.001362,"end_time":"2026-10-23T06:26:11.025011+00:00","exception":false,"start_time":"2026-10-23T06:26:11.023649+00:00","status":"completed"},"tags":[]},"source":["## 2. 예측 (목적 : fold 가중치별 예측 후 평균)"]},{"cell_type":"code","execution_count":3,"id":"e251370b","metadata":{"execution":{"iopub.execute_input":"2026-10-23T06:26:11.029153Z","iopub.status.busy":"2026-10-23T06:26:11.028906Z","iopub.status.idle":"2026-10-23T06:26:24.707015Z","shell.execute_reply":"2026-10-23T06:26:24.706162Z"},"papermill":{"duration":13.682096,"end_time":"2026-10-23T06:26:24.708606+00:00","exception":false,"start_time":"2026-10-23T06:26:11.02651+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["fold [0, 1, 2, 3, 4] 평균 예측 완료 13.7s | 예측 합 [1.]\n"]}],"source":["def load_model(path):\n","    bb = timm.create_model(\"efficientnet_b0\", pretrained=False, in_chans=1, num_classes=len(CLASSES))  # 인터넷 불필요\n","    bb.load_state_dict(torch.load(path, map_location=\"cpu\"))       # 저장 가중치는 백본만 (E1~E4 공통 형식)\n","    return HMSNet(bb, INPUT).to(DEVICE).eval()\n","\n","@torch.no_grad()\n","def predict(model, XS, XE, bs=64):\n","    n, out = len(XS if XS is not None else XE), []\n","    for i in range(0, n, bs):\n","        s = torch.from_numpy(XS[i:i + bs]).to(DEVICE) if XS is not None else None\n","        e = torch.from_numpy(XE[i:i + bs]).to(DEVICE) if XE is not None else None\n","        with torch.autocast(device_type=\"cuda\", enabled=DEVICE == \"cuda\"):\n","            out.append(F.softmax(model(s, e).float(), dim=1).cpu().numpy())\n","    return np.concatenate(out)\n","\n","t0 = time.time()\n","models = {int(p.stem.replace(\"fold\", \"\")): load_model(p) for p in FOLD_FILES}\n","pred_test = np.mean([predict(m, XS_test, XE_test) for m in models.values()], axis=0)\n","print(f\"fold {sorted(models)} 평균 예측 완료 {time.time() - t0:.1f}s | 예측 합 {pred_test.sum(axis=1).round(4)[:5]}\")"]},{"cell_type":"markdown","id":"d5a7c2bf","metadata":{"papermill":{"duration":0.001477,"end_time":"2026-10-23T06:26:24.711624+00:00","exception":false,"start_time":"2026-10-23T06:26:24.710147+00:00","status":"completed"},"tags":[]},"source":["## 3. 일관성 점검 (목적 : 학습·추론 전처리 불일치 탐지, 공개 테스트 1건일 때만 실행)"]},{"cell_type":"code","execution_count":4,"id":"a9ba2809","metadata":{"execution":{"iopub.execute_input":"2026-10-23T06:26:24.716114Z","iopub.status.busy":"2026-10-23T06:26:24.715454Z","iopub.status.idle":"2026-10-23T06:26:45.062692Z","shell.execute_reply":"2026-10-23T06:26:45.061704Z"},"papermill":{"duration":20.351302,"end_time":"2026-10-23T06:26:45.06437+00:00","exception":false,"start_time":"2026-10-23T06:26:24.713068+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["OOF 재현 점검 32건 | 최대 차이 0.0013 | 평균 0.0003\n"]}],"source":["# 같은 추론 경로로 학습 데이터 일부를 다시 예측해, 학습 때 저장한 OOF 예측과 같은지 확인한다.\n","# 차이가 크면 전처리(구간 선택, 변환, 표준화)가 학습 때와 다르다는 뜻이다. 숨김 테스트 재실행 때는 건너뜀.\n","if len(test) < 10 and (MODEL_DIR / \"oof.csv\").exists():\n","    oof = pd.read_csv(MODEL_DIR / \"oof.csv\")\n","    rep = select_representative(build_targets(pd.read_csv(DATA_DIR / \"train.csv\")))\n","    chk = oof.sample(min(32, len(oof)), random_state=0).merge(\n","        rep[[\"eeg_id\", \"spectrogram_id\", \"spectrogram_label_offset_seconds\", \"eeg_label_offset_seconds\"]], on=\"eeg_id\")\n","    diffs = []\n","    for k, g in chk.groupby(\"fold\"):\n","        if k not in models:\n","            continue\n","        XS, XE = build_inputs(g, \"train\", g.spectrogram_label_offset_seconds.to_numpy(), g.eeg_label_offset_seconds.to_numpy())\n","        p = predict(models[k], XS, XE)\n","        diffs.append(np.abs(p - g[[f\"pred_{c}\" for c in CLASSES]].to_numpy()).max(axis=1))\n","    diffs = np.concatenate(diffs)\n","    print(f\"OOF 재현 점검 {len(diffs)}건 | 최대 차이 {diffs.max():.4f} | 평균 {diffs.mean():.4f}\")\n","    assert diffs.max() < 0.02, \"학습 때 예측과 다릅니다 : 전처리 불일치 가능성 → 제출 중단\"\n","else:\n","    print(\"일관성 점검 건너뜀 (숨김 테스트 실행 또는 oof.csv 없음)\")"]},{"cell_type":"markdown","id":"de5623ce","metadata":{"papermill":{"duration":0.001561,"end_time":"2026-10-23T06:26:45.06761+00:00","exception":false,"start_time":"2026-10-23T06:26:45.066049+00:00","status":"completed"},"tags":[]},"source":["## 4. 제출 파일 (목적 : 양식 검증 후 저장)"]},{"cell_type":"code","execution_count":5,"id":"d766a01e","metadata":{"execution":{"iopub.execute_input":"2026-10-23T06:26:45.07216Z","iopub.status.busy":"2026-10-23T06:26:45.071455Z","iopub.status.idle":"2026-10-23T06:26:45.102291Z","shell.execute_reply":"2026-10-23T06:26:45.101539Z"},"papermill":{"duration":0.034706,"end_time":"2026-10-23T06:26:45.103761+00:00","exception":false,"start_time":"2026-10-23T06:26:45.069055+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>eeg_id</th>\n","      <th>seizure_vote</th>\n","      <th>lpd_vote</th>\n","      <th>gpd_vote</th>\n","      <th>lrda_vote</th>\n","      <th>grda_vote</th>\n","      <th>other_vote</th>\n"