ect.mean(), 1 - inc.correct.mean()\n","    return {\"판정 대상\": len(chk), \"일치율\": chk.status.eq(\"일치\").mean(), \"일치 n\": len(con), \"불일치 n\": len(inc),\n","            \"오답률(일치)\": err_c, \"오답률(불일치)\": err_i, \"오답률 비\": err_i / max(err_c, 1e-9),\n","            \"KL(일치)\": con.kl.mean(), \"KL(불일치)\": inc.kl.mean(), \"KL 비\": inc.kl.mean() / max(con.kl.mean(), 1e-9)}\n","\n","high, allv = summarize(df[df.high_vote == 1]), summarize(df)\n","summary = pd.DataFrame({\"고득표\": high, \"전체(참고)\": allv}).T\n","display(summary.round(3))\n","\n","ok_rate, ok_flag = high[\"일치율\"] >= 0.80, high[\"오답률 비\"] >= 2.0\n","print(f\"근거 일치율 {high['일치율']:.1%} (목표 ≥ 80%) → {'달성' if ok_rate else '미달'}\")\n","print(f\"플래그 실효성 : 오답률 불일치 {high['오답률(불일치)']:.1%} vs 일치 {high['오답률(일치)']:.1%} → {high['오답률 비']:.2f}배 \"\n","      f\"(목표 ≥ 2배) → {'달성' if ok_flag else '미달'} | KL 비 {high['KL 비']:.2f}배\")\n","\n","h = df[df.high_vote == 1]\n","hc = h[h.status != \"판정 대상 아님\"]\n","by_cls = pd.DataFrame({c: {\"n\": len(g), \"일치율\": g.status.eq(\"일치\").mean(),\n","                           \"정답률(일치)\": g[g.status == \"일치\"].correct.mean(),\n","                           \"정답률(불일치)\": g[g.status == \"불일치\"].correct.mean()}\n","                       for c, g in hc.groupby(\"pred\")}).T.round(3)\n","display(by_cls)\n","claim_cols = [f\"claim_{a}\" for a in AXES]\n","axis_tab = pd.DataFrame({AXES[a][\"name\"]: (h[h[f\"claim_{a}\"] >= 0][f\"claim_{a}\"].value_counts(normalize=True).sort_index().round(3))\n","                         for a in AXES}).rename(index={0: \"근거 0개\", 1: \"1개\", 2: \"2개\"})\n","print(\"축별 근거 충족 분포 (고득표, 해당 주장이 있는 구간)\")\n","display(axis_tab)"]},{"cell_type":"markdown","id":"77ab69e5","metadata":{"papermill":{"duration":0.002832,"end_time":"2026-10-26T06:23:38.317379+00:00","exception":false,"start_time":"2026-10-26T06:23:38.314547+00:00","status":"completed"},"tags":[]},"source":["## 3-2. 진단 분석 (목적 : 목표 미달 원인 파악 · 보완안 근거 / 1차 판정은 변경하지 않음)\n","\n","- ① **오답 분해** : 고득표 오답을 혼동 유형별로 나누고, 유형마다 플래그가 붙은 비율 → 규칙이 확인할 수 있는 오답과 없는 오답 구분\n","- ② **축별 실효성** : 주장한 축이 실제로 틀렸는가 (예 : 편측 주장 → 전문가 판정이 전반) 를 근거 0개 vs 근거 있음으로 비교\n","- ③ **기준 민감도** : 지지 기준 1/2 vs 2/2, 임계값이 불안정한 지표(center_ctx_centroid_absmax) 제외\n","- ④ **확률 대조군** : 같은 수의 구간을 '최고 확률이 낮은 순'으로 플래그 / 확률 3분위 안에서 근거 불일치의 추가 효과 / 결합 플래그\n","- 모든 변형도 fold별 학습 fold 임계값(THR_BY_FOLD)으로 계산 → 누수 없음. 다만 변형 선택은 결과를 본 뒤 하므로 **사후 보완**으로 표기"]},{"cell_type":"code","execution_count":5,"id":"12120036","metadata":{"execution":{"iopub.execute_input":"2026-10-26T06:23:38.325157Z","iopub.status.busy":"2026-10-26T06:23:38.324469Z","iopub.status.idle":"2026-10-26T06:23:38.381049Z","shell.execute_reply":"2026-10-26T06:23:38.380197Z"},"papermill":{"duration":0.062472,"end_time":"2026-10-26T06:23:38.382811+00:00","exception":false,"start_time":"2026-10-26T06:23:38.320339+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["① 고득표 오답 분해 (플래그 비율 = 그 유형 오답 중 '불일치'로 걸러진 비율)\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>오답 n</th>\n","      <th>비율</th>\n","      <th>플래그 비율</th>\n","      <th>판정 대상 아님 비율</th>\n","    </tr>\n","    <tr>\n","      <th>오답 유형</th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>Other 관련</th>\n","      <td>1194</td>\n","      <td>0.774</td>\n","      <td>0.078</td>\n","      <td>0.665</td>\n","    </tr>\n","    <tr>\n","      <th>Seizure 관련</th>\n","      <td>139</td>\n","      <td>0.090</td>\n","      <td>0.266</td>\n","      <td>0.000</td>\n","    </tr>\n","    <tr