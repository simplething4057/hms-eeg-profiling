,"end_time":"2026-10-26T06:10:52.960947+00:00","exception":false,"start_time":"2026-10-26T06:10:40.306182+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["SRC_ROOT : /kaggle/input/datasets/sungik4057/hms-src \n","FEATS    : /kaggle/input/notebooks/sungik4057/nb03-profile-lgbm/profile/profile_features.csv \n","RECIPE   : /kaggle/input/notebooks/sungik4057/nb08-pack/e8_recipe.json {'candidate': 'E4+E5 + P1v2', 'models': ['E4', 'E5'], 'dl_weight': 0.85, 'use_p1': True, 'temperature': 1.0, 'cv_kl_high_nested': 0.2955, 'dl_versions': {'E4': 6, 'E5': 7}}\n","E4 OOF  : /kaggle/input/notebooks/sungik4057/nb08-pack/models/E4/oof.csv\n","E5 OOF  : /kaggle/input/notebooks/sungik4057/nb08-pack/models/E5/oof.csv\n","P1 OOF  : /kaggle/input/notebooks/sungik4057/nb08-pack/models/P1/oof.csv\n"]}],"source":["import sys, os, json\n","from pathlib import Path\n","\n","INPUT_ROOT = Path(os.environ.get(\"HMS_INPUT_ROOT\", \"/kaggle/input\"))\n","def find_file(*patterns):\n","    for pat in patterns:\n","        hits = sorted(INPUT_ROOT.glob(pat)) if INPUT_ROOT.exists() else []\n","        if hits:\n","            return hits[0]\n","    return None\n","\n","SRC_ROOT = Path(os.environ.get(\"HMS_SRC_DIR\") or find_file(\"**/src/reasoning/rules.py\").parents[2])\n","sys.path.insert(0, str(SRC_ROOT))\n","FEAT_PATH = Path(os.environ.get(\"HMS_FEATS\") or find_file(\"**/profile/profile_features.csv\"))\n","RECIPE_PATH = find_file(\"**/e8_recipe.json\")\n","OOF = {m: Path(os.environ.get(f\"HMS_{m}_OOF\") or find_file(f\"**/models/{m}/oof.csv\")) for m in [\"E4\", \"E5\", \"P1\"]}\n","\n","import numpy as np\n","import pandas as pd\n","from src.data.targets import PROB_COLS, CLASSES\n","from src.eval.metrics import evaluate\n","from src.reasoning.rules import AXES, FEATURES, fit_thresholds, check_claims\n","from src.reasoning.report import make_report, format_report, confidence\n","\n","OUT_DIR = Path(os.environ.get(\"HMS_OUT_DIR\", \"/kaggle/working\")) / \"reasoning\"\n","OUT_DIR.mkdir(parents=True, exist_ok=True)\n","RECIPE = json.load(open(RECIPE_PATH)) if RECIPE_PATH else {\"models\": [\"E4\", \"E5\"], \"dl_weight\": 0.85, \"use_p1\": True, \"temperature\": 1.0}\n","print(\"SRC_ROOT :\", SRC_ROOT, \"\\nFEATS    :\", FEAT_PATH, \"\\nRECIPE   :\", RECIPE_PATH, RECIPE)\n","for m, p in OOF.items():\n","    print(f\"{m} OOF  : {p}\")"]},{"cell_type":"markdown","id":"bce9034e","metadata":{"papermill":{"duration":0.002241,"end_time":"2026-10-26T06:10:52.965744+00:00","exception":false,"start_time":"2026-10-26T06:10:52.963503+00:00","status":"completed"},"tags":[]},"source":["## 1. E8 확률 재구성 (목적 : 최종 제출 조합의 OOF 확률 / 판정에 쓰는 딥러닝 측 입력)"]},{"cell_type":"code","execution_count":2,"id":"4a3efe7a","metadata":{"execution":{"iopub.execute_input":"2026-10-26T06:10:52.972465Z","iopub.status.busy":"2026-10-26T06:10:52.971326Z","iopub.status.idle":"2026-10-26T06:10:54.239638Z","shell.execute_reply":"2026-10-26T06:10:54.238683Z"},"papermill":{"duration":1.273539,"end_time":"2026-10-26T06:10:54.241411+00:00","exception":false,"start_time":"2026-10-26T06:10:52.967872+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["E8 OOF 재구성 : 고득표 KL 0.2955 (nb07 0.2955) | 편측 AUC 0.9445 | 주기성 AUC 0.9364 | Seizure 민감도 0.9563 | 17,089건\n","고득표 5,939건 | 최다 확률 클래스 = 전문가 다수 판정 일치율 0.740\n"]}],"source":["feats = pd.read_csv(FEAT_PATH)\n","PRED = [f\"pred_{c}\" for c in CLASSES]\n","def oof(m):\n","    return pd.read_csv(OOF[m]).set_index(\"eeg_id\").loc[feats.eeg_id, PRED].to_numpy()\n","\n","dl = np.mean([oof(m) for m in RECIPE[\"models\"]], axis=0)\n","w = RECIPE[\"dl_weight\"]\n","prob = w * dl + (1 - w) * oof(\"P1\") if RECIPE[\"use_p1\"] else dl\n","if RECIPE.get(\"temperature\", 1.0) != 1.0:\n","    z = np.log(np.clip(prob, 1e-7, 1)) / RECIPE[\"temperature\"]; z = np.exp(z - z.max(1, keepdims=True)); prob = z / z.sum(1, keepdims=True)\n","\n","m = evaluate(feats, prob)\n","print(f\"E8 OOF 재구성 : 고득표 KL {m['kl_high']:.4f} (nb07 0.2955) | 편측 AUC {m['auc_lat']:.4f} | 주기성 AUC {m['auc_pd']:.4f} | \"\n","      f\"Seizure 민감도 {m['sens_at_spec90']:.4f} | {len(feats):,}건\")\n","\n","pred_cls = np.array(CLASSES)[prob.argmax(1)]\n","truth = feats.expert_consensus.str.lower().to_numpy()\n","Y = feats[PROB_COLS].to_numpy()\n","kl_row = (np.clip(Y, 1e-15, 1) * np.log(np.clip(Y, 1e-15, 1) / np.clip(prob, 1e-15, 1))).sum(1)\n","hv = feats.high_vote.to_numpy().astype(bool)\n","print(f\"고득표 {hv.sum():,}건 | 최다 확률 클래스 = 전문가 다수 판정 일치율 {(pred_cls[hv] == truth[hv]).mean():.3f}\")"]},{"cell_type":"markdown","id":"6290abdf","metadata":{"papermill":{"duration":0.002246,"end_time":"2026-10-26T06:10:54.246015+00:00","exception":false,"start_time":"2026-10-26T06:10:54.243769+00:00","status":"completed"},"tags":[]},"source":["## 2. 규칙 적용 (목적 : 판정마다 근거 지표 충족 여부 판정 / 누수 방지 : 임계값은 학습 fold에서만)\n","\n","- fold k 구간에는 **fold k를 뺀 나머지 fold의 고득표 구간**에서 Youden 기준(민감도 + 특이도 최대)으로 정한 임계값을 적용\n","- 임계값이 fold 간에 크게 흔들리지 않는지(안정성)도 함께 확인"]},{"cell_type":"code","execution_count":3,"id":"d323ea6f","metadata":{"execution":{"iopub.execute_input":"2026-10-26T06:10:54.252246Z","iopub.status.busy":"2026-10-26T06:10:54.251899Z","iopub.status.idle":"2026-10-26T06:10:54.52497Z","shell.execute_reply":"2026-10-26T06:10:54.524038Z"},"papermill":{"duration":0.278639,"end_time":"2026-10-26T06:10:54.52686+00:00","exception":false,"start_time":"2026-10-26T06:10:54.248221+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>abs_asym_total</th>\n","      <th>abs_asym_delta</th>\n"