rt, confidence\n","\n","OUT_DIR = Path(os.environ.get(\"HMS_OUT_DIR\", \"/kaggle/working\")) / \"reasoning\"\n","OUT_DIR.mkdir(parents=True, exist_ok=True)\n","RECIPE = json.load(open(RECIPE_PATH)) if RECIPE_PATH else {\"models\": [\"E4\", \"E5\"], \"dl_weight\": 0.85, \"use_p1\": True, \"temperature\": 1.0}\n","print(\"SRC_ROOT :\", SRC_ROOT, \"\\nFEATS    :\", FEAT_PATH, \"\\nRECIPE   :\", RECIPE_PATH, RECIPE)\n","for m, p in OOF.items():\n","    print(f\"{m} OOF  : {p}\")"]},{"cell_type":"markdown","id":"c7ec235b","metadata":{"papermill":{"duration":0.002513,"end_time":"2026-10-26T06:23:37.135625+00:00","exception":false,"start_time":"2026-10-26T06:23:37.133112+00:00","status":"completed"},"tags":[]},"source":["## 1. E8 확률 재구성 (목적 : 최종 제출 조합의 OOF 확률 / 판정에 쓰는 딥러닝 측 입력)"]},{"cell_type":"code","execution_count":2,"id":"8e45e1fd","metadata":{"execution":{"iopub.execute_input":"2026-10-26T06:23:37.142429Z","iopub.status.busy":"2026-10-26T06:23:37.141873Z","iopub.status.idle":"2026-10-26T06:23:37.910365Z","shell.execute_reply":"2026-10-26T06:23:37.909395Z"},"papermill":{"duration":0.774022,"end_time":"2026-10-26T06:23:37.912194+00:00","exception":false,"start_time":"2026-10-26T06:23:37.138172+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["E8 OOF 재구성 : 고득표 KL 0.2955 (nb07 0.2955) | 편측 AUC 0.9445 | 주기성 AUC 0.9364 | Seizure 민감도 0.9563 | 17,089건\n","고득표 5,939건 | 최다 확률 클래스 = 전문가 다수 판정 일치율 0.740\n"]}],"source":["feats = pd.read_csv(FEAT_PATH)\n","PRED = [f\"pred_{c}\" for c in CLASSES]\n","def oof(m):\n","    return pd.read_csv(OOF[m]).set_index(\"eeg_id\").loc[feats.eeg_id, PRED].to_numpy()\n","\n","dl = np.mean([oof(m) for m in RECIPE[\"models\"]], axis=0)\n","w = RECIPE[\"dl_weight\"]\n","prob = w * dl + (1 - w) * oof(\"P1\") if RECIPE[\"use_p1\"] else dl\n","if RECIPE.get(\"temperature\", 1.0) != 1.0:\n","    z = np.log(np.clip(prob, 1e-7, 1)) / RECIPE[\"temperature\"]; z = np.exp(z - z.max(1, keepdims=True)); prob = z / z.sum(1, keepdims=True)\n","\n","m = evaluate(feats, prob)\n","print(f\"E8 OOF 재구성 : 고득표 KL {m['kl_high']:.4f} (nb07 0.2955) | 편측 AUC {m['auc_lat']:.4f} | 주기성 AUC {m['auc_pd']:.4f} | \"\n","      f\"Seizure 민감도 {m['sens_at_spec90']:.4f} | {len(feats):,}건\")\n","\n","pred_cls = np.array(CLASSES)[prob.argmax(1)]\n","truth = feats.expert_consensus.str.lower().to_numpy()\n","Y = feats[PROB_COLS].to_numpy()\n","kl_row = (np.clip(Y, 1e-15, 1) * np.log(np.clip(Y, 1e-15, 1) / np.clip(prob, 1e-15, 1))).sum(1)\n","hv = feats.high_vote.to_numpy().astype(bool)\n","print(f\"고득표 {hv.sum():,}건 | 최다 확률 클래스 = 전문가 다수 판정 일치율 {(pred_cls[hv] == truth[hv]).mean():.3f}\")"]},{"cell_type":"markdown","id":"d548e2ab","metadata":{"papermill":{"duration":0.002304,"end_time":"2026-10-26T06:23:37.916908+00:00","exception":false,"start_time":"2026-10-26T06:23:37.914604+00:00","status":"completed"},"tags":[]},"source":["## 2. 규칙 적용 (목적 : 판정마다 근거 지표 충족 여부 판정 / 누수 방지 : 임계값은 학습 fold에서만)\n","\n","- fold k 구간에는 **fold k를 뺀 나머지 fold의 고득표 구간**에서 Youden 기준(민감도 + 특이도 최대)으로 정한 임계값을 적용\n","- 임계값이 fold 간에 크게 흔들리지 않는지(안정성)도 함께 확인"]},{"cell_type":"code","execution_count":3,"id":"22a7b368","metadata":{"execution":{"iopub.execute_input":"2026-10-26T06:23:37.923009Z","iopub.status.busy":"2026-10-26T06:23:37.922691Z","iopub.status.idle":"2026-10-26T06:23:38.206258Z","shell.execute_reply":"2026-10-26T06:23:38.205233Z"},"papermill":{"duration":0.289089,"end_time":"2026-10-26T06:23:38.208268+00:00","exception":false,"start_time":"2026-10-26T06:23:37.919179+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n"," 