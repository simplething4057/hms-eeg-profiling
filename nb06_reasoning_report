"]), (\"rhythmic\", RDA, [\"lrda\", \"grda\"]),\n","                              (\"seizure\", {\"seizure\"}, [\"seizure\"])]:\n","    g = h[h.pred.isin(claim_cls) & (h[f\"claim_{ax}\"] >= 0)]\n","    if ax != \"seizure\":\n","        g = g[g.truth.isin(PAT)]                                   # 축 판단이 정의되는 패턴 클래스만\n","    high_claim = g.pred.isin(cls_hi) if ax != \"lateral\" else g.pred.isin(LAT)\n","    truth_hi = g.truth.isin(cls_hi) if ax != \"lateral\" else g.truth.isin(LAT)\n","    axis_wrong = high_claim != truth_hi\n","    zero = g[f\"claim_{ax}\"] == 0\n","    r0, r1 = axis_wrong[zero].mean(), axis_wrong[~zero].mean()\n","    rows2.append({\"축\": AXES[ax][\"name\"], \"주장 n\": len(g), \"근거 0개 비율\": round(zero.mean(), 3),\n","                  \"축 오류율(근거 0개)\": round(r0, 3), \"축 오류율(근거 있음)\": round(r1, 3), \"비\": round(r0 / r1, 2) if r1 > 0 else np.nan})\n","print(\"② 축별 실효성 (축 오류 = 주장한 축 방향이 전문가 판정과 다름)\")\n","display(pd.DataFrame(rows2))"]},{"cell_type":"code","execution_count":6,"id":"ee8c426a","metadata":{"execution":{"iopub.execute_input":"2026-10-26T06:10:54.699179Z","iopub.status.busy":"2026-10-26T06:10:54.698841Z","iopub.status.idle":"2026-10-26T06:10:55.28968Z","shell.execute_reply":"2026-10-26T06:10:55.288959Z"},"papermill":{"duration":0.597154,"end_time":"2026-10-26T06:10:55.2915+00:00","exception":false,"start_time":"2026-10-26T06:10:54.694346+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["[알림] hms-src의 check_claims가 이전 버전 → 노트북 내 동일 함수로 진단 실행\n","③·④ 기준 민감도 · 확률 대조군 (고득표, 판정 대상 구간)\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n"," 